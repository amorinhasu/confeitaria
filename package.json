{
  "name": "momozin-discord-bot",
  "version": "0.1.0",
  "description": "Bot privado de casal Momozin para Discord com trivia, cine, estudos e mimos.",
  "main": "src/start.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "start": "node src/start.js",
    "start:auto-deploy": "AUTO_DEPLOY_COMMANDS=true node src/start.js",
    "emojis": "node src/list-emojis.js",
    "test:manual": "node scripts/check-manual-custom-ids.js",
    "test:pudinzinho": "node scripts/check-pudinzinho-role-flow.js"
  },
  "keywords": [
    "discord",
    "discord.js",
    "momozin",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "14.26.4",
    "dotenv": "^16.4.7",
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
